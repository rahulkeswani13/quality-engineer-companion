# Leave GOOGLE_API_KEY unset to use the local (no-network) provider for eval
# and CLI. Set it for the live Gemini demo (Flash + gemini-embedding-2).
# /health reports which retriever actually ran: gemini-embedding-2 vs
# local_hash_fallback. If the key is present and COMPANION_PROVIDER is unset,
# the server uses gemini; quota/timeout/missing key fall back to local helpers.
GOOGLE_API_KEY=
# COMPANION_PROVIDER=local
COMPANION_HOST=0.0.0.0
COMPANION_PORT=8000

# Per-process database overrides so parallel servers/tests never share state.
# Defaults live under companion/.cache/.
# COMPANION_MOM_DB=companion/.cache/mom.sqlite
# COMPANION_CKPT_DB=companion/.cache/checkpoints.sqlite

# RESET_ON_START=1 clears MOM + checkpoints at boot (repeatable demo).
# COMPANION_ALLOWED_ORIGINS widens CORS beyond localhost Vite origins.
# COMPANION_RERANK=0 disables the cross-encoder (overlap rerank is used).
# Docker compose always sets COMPANION_RERANK=0. Local extra:
#   pip install -e ".[rerank]" && COMPANION_RERANK=1

# Optional gate for a public host. Unset = click-and-run, no password.
# DEMO_PASSWORD=choose-a-password
